# --- NekoMind .gitignore ---

# Segredos e configuracoes locais
.env
*.env
!.env.example

# Binarios e dependencias de plataforma (gerados/baixados localmente)
esp-idf/
tools/
vscode-portable/
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ESP-IDF / builds
build/
sdkconfig
sdkconfig.old
managed_components/

# Dados locais (banco SQLite e audio)
backend/storage/
*.raw
*.sqlite3-*
*.db-*
*.db.bak-*
*.db
*.sqlite3
*.wav
*.aiff

# Streamlit
frontend/streamlit/.streamlit/secrets.toml

# SO / editores
.DS_Store
Thumbs.db

# Logs
*.log

# Relatórios locais gerados pelo pipeline de validação
relatorio-pipeline*/

# Evidências visuais geradas (regenerar com a identidade atual)
/ScreenshotsToCloseLoop/runs/
/output/concepts/nekomind-3d/
/output/prototypes/realtime-3d/

# Atalho local para iniciar a apresentação com dois cliques
/iniciar_nekomind.bat
