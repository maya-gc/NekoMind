# NekoMind - exemplos de configuracoes (raiz).
# Valores reais vao em backend/.env (nunca versionar).

# Backend
NEKOMIND_DATABASE_URL=sqlite:///./backend/storage/nekomind.db
NEKOMIND_ASR_PROVIDER=mock
NEKOMIND_LLM_PROVIDER=mock
NEKOMIND_LLM_API_KEY=

# Portas
NEKOMIND_HOST=127.0.0.1
NEKOMIND_PORT=8000