# Copiar para backend/.env. Nao versionar dados locais nem credenciais.
NEKOMIND_DATABASE_URL=sqlite:///./storage/nekomind.db
NEKOMIND_STORAGE_DIR=./storage/audio

# Demo explicito por padrao: nao carrega modelos nem exige chave.
NEKOMIND_MODE=demo
NEKOMIND_ASR_PROVIDER=mock
NEKOMIND_LLM_PROVIDER=mock

# Para ensaio real local, preparar modelo local antes. O backend usa local_files_only.
# NEKOMIND_MODE=real
# NEKOMIND_ASR_PROVIDER=faster_whisper
# NEKOMIND_ASR_MODEL_SIZE=/caminho/absoluto/modelo-ctranslate2
# NEKOMIND_LLM_PROVIDER=local_keywords
# local_keywords e opcao explicita local/offline; nao e LLM, mock ou API remota.
NEKOMIND_ASR_MODEL_SIZE=small
NEKOMIND_ASR_DEVICE=cpu
NEKOMIND_ASR_COMPUTE_TYPE=int8

# Mesmo valor de --port no CLI; baud fixo115200 e PCM fixo16kHz mono16bit.
NEKOMIND_SERIAL_PORT=

# Privacidade e operacao local.
# false remove audio bruto local apos transcricao/persistencia bem-sucedidas.
NEKOMIND_RETAIN_RAW_AUDIO=false
# Se vazio, o Mac bridge usa storage.parent/mac.
NEKOMIND_MAC_DATA_DIR=
NEKOMIND_FAIR_IDLE_SECONDS=90
NEKOMIND_BRIDGE_TIMEOUT_SECONDS=8
