# NekoMind Backend - exemplo de configuracao.
# Copie para ".env" e ajuste. NUNCA versione o .env nem chaves reais.

# Banco de dados (padrao: SQLite local). Para PostgreSQL:
# NEKOMIND_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nekomind
NEKOMIND_DATABASE_URL=sqlite:///./storage/nekomind.db

# Onde os audios recebidos sao gravados
NEKOMIND_STORAGE_DIR=./storage/audio

# Provedores de IA: "mock" = offline, sem chave, dados de demonstracao.
NEKOMIND_ASR_PROVIDER=mock
NEKOMIND_LLM_PROVIDER=mock

# Chave de API da LLM (somente quando usar provedor real). NAO versionar.
NEKOMIND_LLM_API_KEY=

# Serial do dispositivo (futuro). Ex.: COM5 (Windows) ou /dev/ttyACM0 (Linux)
NEKOMIND_SERIAL_PORT=
NEKOMIND_SERIAL_BAUDRATE=115200

# Rede local
NEKOMIND_HOST=127.0.0.1
NEKOMIND_PORT=8000
