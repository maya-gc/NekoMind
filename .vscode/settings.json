{
  "cSpell.language": "en,pt",
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "esp-idf/**": true,
    "tools/**": true,
    "vscode-portable/**": true
  },
  "search.exclude": {
    "esp-idf/**": true,
    "tools/**": true,
    "vscode-portable/**": true,
    "build/**": true
  },
  "files.watcherExclude": {
    "esp-idf/**": true,
    "tools/**": true,
    "vscode-portable/**": true,
    "build/**": true
  },
  "espidf.port": "/dev/ttyACM0",
  "espidf.portWin": "COM5",
  "espidf.adapterTargetName": "esp32s3",
  "espidf.openOcdConfigs": ["board/esp32s3-builtin.cfg"],
  "idf.flashType": "UART",
  "idf.portWin": "COM5",
  "idf.port": "/dev/ttyACM0",
  "idf.adapterTargetName": "esp32s3",
  "idf.openOcdConfigs": ["board/esp32s3-builtin.cfg"],
  "idf.showOnboardingOnInit": false,
  "idf.espIdfPath": "${workspaceFolder}/esp-idf",
  "idf.toolsPath": "${workspaceFolder}/tools",
  "idf.pythonBinPath": "${workspaceFolder}/tools/python_env/idf5.3_py3.13_env/Scripts/python.exe",
  "espidf.espIdfPath": "${workspaceFolder}/esp-idf",
  "espidf.toolsPath": "${workspaceFolder}/tools",
  "espidf.pythonBinPath": "${workspaceFolder}/tools/python_env/idf5.3_py3.13_env/Scripts/python.exe",
  "cmake.configureOnOpen": true,
  "cmake.sourceDirectory": "${workspaceFolder}/iot/nekomind_firmware",
  "cmake.buildDirectory": "${workspaceFolder}/iot/nekomind_firmware/build",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/iot/nekomind_firmware/build/compile_commands.json",
  "C_Cpp.intelliSenseMode": "gcc-x64",
  "C_Cpp.errorSquiggles": "enabled",
  "clangd.path": "${workspaceFolder}/tools/tools/xtensa-esp-elf/esp-13.2.0_20240530/xtensa-esp-elf/bin/clangd",
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["backend/tests"],
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.ruffEnabled": true
}